# MongoDB Database Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/civicpulse?retryWrites=true&w=majority

# Google Gemini API Key (Multilingual extraction, AI Chat, verification)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Sarvam AI API Key (Indian Language STT & TTS)
SARVAM_API_KEY=your_sarvam_api_key_here

# Optional: Jina Search API Key (Water intelligence news gathering)
JINA_API_KEY=your_jina_key_here

# Optional: Twilio Configuration (IVR Phone Hotline)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Optional: Scrapingdog API Key (Places autocomplete search)
SCRAPINGDOG_API_KEY=your_scrapingdog_key_here

# Optional: NVIDIA API Key (For Nemotron test models)
NVIDIA_API_KEY=your_nvidia_key_here
